<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="Optum" value="https://centraluhg.jfrog.io/artifactory/api/nuget/v3/glb-nuget-vir/index.json" />
    <!-- Project-specific repository for commpay-vpay packages -->
    <add key="CommpayVpay" value="https://centraluhg.jfrog.io/artifactory/api/nuget/v3/commpay-vpay-nuget-vir" protocolVersion="3" />
    <!-- Global repository for other packages -->
    <add key="Artifactory" value="https://centraluhg.jfrog.io/artifactory/api/nuget/v3/glb-nuget-vir" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="Optum">
      <package pattern="Optum.*" />
      <package pattern="VPay.*" />
    </packageSource>
    <packageSource key="CommpayVpay">
      <package pattern="Vpay.*" />
    </packageSource>
    <packageSource key="Artifactory">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <Optum>
      <add key="Username" value="%JF_USER%" />
      <add key="ClearTextPassword" value="%JF_TOKEN%" />
    </Optum>
    <CommpayVpay>
      <add key="Username" value="%JF_USER%" />
      <add key="ClearTextPassword" value="%JF_TOKEN%" />
    </CommpayVpay>
    <Artifactory>
      <add key="Username" value="%JF_USER%" />
      <add key="ClearTextPassword" value="%JF_TOKEN%" />
    </Artifactory>
  </packageSourceCredentials>
</configuration>