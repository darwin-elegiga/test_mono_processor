{
  "Logging": {
    "Debug": {
      "LogLevel": {
        "Default": "Information",
        "System.Net.Http.HttpClient.Default": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient.Default": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "LogLevel": {
      "Default": "Debug",
      "System.Net.Http.HttpClient.Default": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "GELF": {
      "Host": "graylogsandbox.vpayusa.net",
      "Port": 5555,
      "LogSource": "VPay.Ols.Processor.Api",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient.Default": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "OlsDatabase": {
    "BaseConnectionString": "Data Source=;Initial Catalog=;MultiSubnetFailover=True;ApplicationIntent=ReadWrite;MultipleActiveResultSets=true",
    "Hostname": "{ToBeReplaced}",
    "Database": "{ToBeReplaced}",
    "Username": "{ToBeReplaced}",
    "Password": "{ToBeReplaced}",
    "DefaultCommandTimeout": 3600
  }
}
