        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
        <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="8.1.4" />
        <PackageReference Include="System.IO.Abstractions" Version="22.0.16" />
        <PackageReference Include="VPay.AspNetCore.Mvc" Version="2.0.0" />
        <PackageReference Include="VPay.AspNetCore.SwashBuckle" Version="2.0.0" />
        <PackageReference Include="VPay.AspNetCore.SwashBuckle.HealthChecks" Version="2.0.0" />
        <PackageReference Include="VPay.Extensions.Logging.GrayLog" Version="2.0.0" />
        <PackageReference Include="VPay.MassTransit.DependencyInjection" Version="3.0.8" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\database\VPay.Ols.Processor.Data.Sql\VPay.Ols.Processor.Data.Sql.csproj" />
