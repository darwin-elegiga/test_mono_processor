{
  "Logging": {
    "IncludeScopes": true,
    "LogLevel": {
      "Default": "Debug"
    },
    "Debug": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    },
    "GELF": {
      "Host": "graylogsandbox.vpayusa.net",
      "Port": 5555,
      "LogSource": "VPay.Ols.Processor.QueueConsumers",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error"
      }
    }
  },
  "OlsProcessorQueue": {
    "username": "rabbitmq",
    "password": "rabbitmq",
    "virtualHost": "/",
    "port": 5672,
    "hostnames": [ "ols-processor-rabbitmq" ],
    "retries": {
      "maxRetries": 5,
      "initialRetryDelay": "00:00:30",
      "retryDelayIncrement": "00:00:30"
    }
  },
  "OlsDatabase": {
    "BaseConnectionString": "Data Source=;Initial Catalog=;MultiSubnetFailover=True;ApplicationIntent=ReadWrite;Encrypt=False;MultipleActiveResultSets=true",
    "Hostname": "{ToBeReplaced}",
    "Database": "{ToBeReplaced}",
    "Username": "{ToBeReplaced}",
    "Password": "{ToBeReplaced}",
    "DefaultCommandTimeout": 3600
  },
  "AuthorizationFileSettings": {
    "WorkingDirectory": "/SRVFS/ols/AuthorizationFiles",
    "OutputDirectory": "/SRVFS/ols/AuthorizationFiles/Optum"
  },
  "NonFinancialFileSettings": {
    "WorkingDirectory": "/SRVFS/ols/NonFinancialFiles",
    "OutputDirectory": "/SRVFS/ols/NonFinancialFiles/Optum"
  },
  "PostedTransactionsFileSettings": {
    "WorkingDirectory": "/SRVFS/ols/PostedTransactionFiles",
    "OutputDirectory": "/SRVFS/ols/PostedTransactionFiles/Optum"
  },
  "FileTransferServiceSettings": {
    "FileTransferServiceFolderPath": "/SRVFS/filetransfer",
    "FileTransferServiceFolderSubPath": "optum_ols"
  },
  "SigningServiceOptions": {
    "PrivateKeyPath": "/app/id-rsa.key"
  },
  "FileTransferServiceRabbitQueue": {
    "username": "{from vault}",
    "password": "{from vault}",
    "virtualHost": "Nacha",
    "port": 5672
  }
}
