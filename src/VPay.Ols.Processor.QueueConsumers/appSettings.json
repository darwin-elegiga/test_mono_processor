{
  "Logging": {
    "IncludeScopes": true,
    "LogLevel": {
      "Default": "Debug"
    },
    "Debug": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    },
    "GELF": {
      "Host": "graylogsandbox.vpayusa.net",
      "Port": 5555,
      "LogSource": "VPay.Ols.Processor.QueueConsumers",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error"
      }
    }
  },
  "OlsProcessorQueue": {
    "username": "rabbitmq",
    "password": "rabbitmq",
    "virtualHost": "/",
    "port": 5672,
    "hostnames": [ "ols-processor-rabbitmq" ],
    "retries": {
      "maxRetries": 5,
      "initialRetryDelay": "00:00:30",
      "retryDelayIncrement": "00:00:30"
    }
  }
}